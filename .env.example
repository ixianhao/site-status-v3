# API URL - required
# UptimeRobot API v3 endpoint.
API_URL="https://api.uptimerobot.com/"

# UptimeRobot API key - required
# Use a Read-Only API key. Do not use or commit your Main API key.
# https://dashboard.uptimerobot.com/integrations
API_KEY="your-read-only-api-key"

# Deployment platform - required
# cloudflare | auto
# Use auto for Vercel or other platforms.
DEPLOYMENT_PLATFORM="auto"

# Site title
SITE_TITLE="Site Status"

# Site description
SITE_DESCRIPTION="A simple status page powered by UptimeRobot"

# Site keywords
SITE_KEYWORDS="status,page,uptime,monitoring"

# Site logo
SITE_LOGO="/favicon.ico"

# ICP filing, optional
SITE_ICP=""

# Count days
# Recommended range: 30 - 90
COUNT_DAYS=60

# Show site links
SHOW_LINK=true

# Password protection, optional
SITE_PASSWORD=""

# JWT secret for password protection
SITE_SECRET_KEY="change-this-secret"
